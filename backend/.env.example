PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=checkout

# Fees, in cents (COP has no decimals; Wompi's amount_in_cents = value * 100)
BASE_FEE_IN_CENTS=500000
DELIVERY_FEE_IN_CENTS=800000
CURRENCY=COP

# Wompi sandbox / UAT credentials (private key + integrity secret are server-side only, never sent to the frontend)
WOMPI_API_URL=https://api-sandbox.co.uat.wompi.dev/v1
WOMPI_PRIVATE_KEY=prv_stagtest_xxx
WOMPI_INTEGRITY_SECRET=stagtest_integrity_xxx
WOMPI_POLL_ATTEMPTS=10
WOMPI_POLL_DELAY_MS=1500
